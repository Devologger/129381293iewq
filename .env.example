# All integrations are optional. Never commit real values or share them in chat.
# Paper trading and strategy research work without these settings.
TERMINAL_ADMIN_PASSWORD=
TRADE_AI_KEY=
TRADE_AI_MODEL=gpt-5-mini
# Discord application Public Key, not a bot token.
DISCORD_PUBLIC_KEY=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Used behind an HTTPS reverse proxy for origin checks and secure cookies.
TERMINAL_PUBLIC_ORIGIN=
# Local writable storage. Defaults to .runtime inside this repository.
TERMINAL_DATA_DIR=
TERMINAL_VAULT_DIR=obsidian-vault
# Optional override for the Python executable.
TERMINAL_PYTHON=python3
# Binance USD-M DEMO execution caps. No production order adapter exists.
BINANCE_DEMO_MAX_ORDER_USDT=500
BINANCE_DEMO_MAX_EXPOSURE_USDT=2000
# Shared research-team budgets: reset daily at UTC midnight.
TEAM_DAILY_BUDGET_USD=1
TEAM_RUN_BUDGET_USD=0.20
TEAM_DAILY_CALL_LIMIT=9
# Conservative accounting estimates; verify rates for your chosen model.
TEAM_INPUT_USD_PER_MILLION=1
TEAM_OUTPUT_USD_PER_MILLION=5
TEAM_CACHED_INPUT_USD_PER_MILLION=1
# Optional escalation requires a model and explicit configured price rates.
TEAM_ESCALATION_MODEL=
TEAM_ESCALATION_INPUT_USD_PER_MILLION=
TEAM_ESCALATION_OUTPUT_USD_PER_MILLION=

# Remote inference only; no local model or OpenAI billing required by default.
TEAM_AI_PROVIDER=openrouter_free
TEAM_REMOTE_MODEL=auto-free
TEAM_REMOTE_KEY=
# Only for a different documented OpenAI-compatible free remote endpoint:
TEAM_REMOTE_BASE_URL=
TEAM_REMOTE_FREE_MODELS=
TEAM_REMOTE_FREE_CONFIRMED=0
TEAM_REMOTE_ANONYMOUS=0

# Optional real FreeRide gateway: TEAM_AI_PROVIDER=freeride
# Install and start using npm run freeride:install / npm run freeride:start.
# Existing TEAM_REMOTE_KEY is reused as your OpenRouter key.
GROQ_API_KEY=
# Enable only after confirming your Groq account uses its free plan.
FREERIDE_GROQ_FREE_CONFIRMED=0
