# All integrations are optional. Never commit real values or share them in chat.
# Paper trading and strategy research work without these settings.
TERMINAL_ADMIN_PASSWORD=
TRADE_AI_KEY=
TRADE_AI_MODEL=gpt-5-mini
# Discord application Public Key, not a bot token.
DISCORD_PUBLIC_KEY=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Separate real Binance keys. This connector reads accounts; it does not submit orders.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
# Used behind an HTTPS reverse proxy for origin checks and secure cookies.
TERMINAL_PUBLIC_ORIGIN=
# Local writable storage. Defaults to .runtime inside this repository.
TERMINAL_DATA_DIR=
TERMINAL_VAULT_DIR=obsidian-vault
# Optional override for the Python executable.
TERMINAL_PYTHON=python3
# Binance USD-M DEMO execution caps. No production order adapter exists.
BINANCE_DEMO_MAX_ORDER_USDT=500
BINANCE_DEMO_MAX_EXPOSURE_USDT=2000
# Shared research-team budgets: reset daily at UTC midnight.
TEAM_DAILY_BUDGET_USD=1
TEAM_RUN_BUDGET_USD=0.20
# Free modes have unlimited app calls; upstream provider quotas still apply.
# This optional cap applies only to explicitly selected paid mode. 0 disables it.
TEAM_DAILY_CALL_LIMIT=0
# Includes provider reasoning tokens; keep bounded. Range 256-4000.
TEAM_MAX_OUTPUT_TOKENS=2000
# Conservative accounting estimates; verify rates for your chosen model.
TEAM_INPUT_USD_PER_MILLION=1
TEAM_OUTPUT_USD_PER_MILLION=5
TEAM_CACHED_INPUT_USD_PER_MILLION=1
# Optional escalation requires a model and explicit configured price rates.
TEAM_ESCALATION_MODEL=
TEAM_ESCALATION_INPUT_USD_PER_MILLION=
TEAM_ESCALATION_OUTPUT_USD_PER_MILLION=

# Remote inference only; no local model or OpenAI billing required by default.
TEAM_AI_PROVIDER=free_cloud
TEAM_REMOTE_MODEL=auto-free
TEAM_REMOTE_KEY=
# Only for a different documented OpenAI-compatible free remote endpoint:
TEAM_REMOTE_BASE_URL=
TEAM_REMOTE_FREE_MODELS=
TEAM_REMOTE_FREE_CONFIRMED=0
TEAM_REMOTE_ANONYMOUS=0

# Optional real FreeRide gateway: TEAM_AI_PROVIDER=freeride
# Install and start using npm run freeride:install / npm run freeride:start.
# Existing TEAM_REMOTE_KEY is reused as your OpenRouter key.
GROQ_API_KEY=
# Enable only after confirming your Groq account uses its free plan.
FREERIDE_GROQ_FREE_CONFIRMED=0

# Council routing excludes advertised/known reasoning models by default.
FREERIDE_ALLOW_REASONING_MODELS=0
# Optional exact OpenRouter :free ID, still subject to free/eligibility checks.
FREERIDE_OPENROUTER_MODEL=
# Optional separate 9Router loopback gateway; see docs/AI-ROUTE-COMPARISON.md.
# Save its restricted endpoint key privately in Connections.
NINE_ROUTER_KEY=
NINE_ROUTER_FREE_ONLY_CONFIRMED=0
# Exact IDs only, with verified upstream free catalogs. No aliases/combos/wildcards.
NINE_ROUTER_FREE_MODELS=groq/llama-3.1-8b-instant

# Public registration is open; all customer AI requires an active subscription. Existing local owner mode stays default.
PENGUIN_ACCOUNT_MODE=0
PENGUIN_OPEN_SIGNUP=1
# Generate privately; never commit a real invitation or password.
PENGUIN_SIGNUP_CODE=
# Only name a client-IP header overwritten by your trusted reverse proxy.
PENGUIN_TRUSTED_IP_HEADER=

# Optional hosted accounts and encrypted integration storage. See docs/HOSTED-SETUP.md.
# Keep local mode until the Supabase project and migration are ready.
PENGUIN_AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate privately. Separate from Supabase; keep a protected recovery copy.
PENGUIN_SECRET_MASTER_KEY=
# Optional Stripe subscriptions. Start with Stripe test-mode keys and a test Price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Customer AI ALWAYS requires an active subscription. This separate flag gates demo entries.
# 1 also requires an active plan for new demo entries. Protection/closing stay available.
PENGUIN_REQUIRE_SUBSCRIPTION=0

# Secure admin setup only: existing confirmed Supabase UUID, never a public role flag.
# Normally leave blank; see npm run admin:setup and docs/LAUNCH-GUIDE.md.
PENGUIN_ADMIN_EXISTING_USER_ID=
