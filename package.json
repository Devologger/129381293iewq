{
  "name": "penguin-trading-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/protect-runtime-traces.mjs",
    "start": "next start",
    "lint": "eslint app components lib instrumentation.ts next.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:research": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "setup:windows": "node scripts/setup-windows.mjs",
    "freeride:install": "node scripts/freeride.mjs install",
    "freeride:start": "node scripts/freeride.mjs start",
    "launch": "node scripts/launch.mjs",
    "admin:setup": "node scripts/admin-setup.mjs",
    "discord:register": "node scripts/discord-register.mjs"
  },
  "dependencies": {
    "lightweight-charts": "5.2.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
